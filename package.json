{
  "name": "emberfall",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && tsc -p tools && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "balance": "esbuild tools/balance/cli.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/emberfall-balance/cli.mjs --log-level=warning && node node_modules/.cache/emberfall-balance/cli.mjs",
    "test": "npm run balance -- check"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.12",
    "typescript": "^5.6.3",
    "vite": "^6.0.5"
  }
}
